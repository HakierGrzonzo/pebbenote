# Prod settings. Copy to .env.prod, adjust, then run:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Host port the backend is published on
BE_PORT=8001

# Ollama host, reachable from the containers
OLLAMA_HOST=ollama.example.lan
CHAT_MODEL=gemma4:e4b
DECISION_MODEL=nimble

# Public issuer URL, must match the `iss` claim of the tokens
OIDC_ISSUER=https://auth.example.com/realms/pebbenote
# Signing keys, fetched from Keycloak over the compose network
OIDC_JWKS_URL=http://keycloak:8080/realms/pebbenote/protocol/openid-connect/certs
