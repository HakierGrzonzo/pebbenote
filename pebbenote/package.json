{
  "name": "pebbenote",
  "author": "HakierGrzonzo",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "pebble": {
    "displayName": "pebbenote",
    "uuid": "6543b444-696e-4860-abd2-2e125362a258",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Dictation",
      "Vibe",
      "Result[20]",
      "NumberOfLines"
    ],
    "resources": {
      "media": []
    },
    "capabilities": [
      "configurable"
    ]
  },
  "devDependencies": {
    "openapi-typescript-codegen": "^0.29.0",
    "pkts": "^0.2.1",
    "prettier": "^3.6.2"
  },
  "scripts": {
    "build": "pkts build",
    "format": "prettier --write ./src/ts",
    "openapi": "openapi --input http://localhost:8000/openapi.json --output src/ts/api --client xhr --name AppClient --request ./request-template.ts && npm run format"
  }
}
